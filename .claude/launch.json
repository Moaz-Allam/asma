{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "asma-dev",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev"],
      "port": 3000
    },
    {
      "name": "asma-local",
      "runtimeExecutable": "node",
      "runtimeArgs": ["scripts/e2e.mjs", "--reuse-build", "--serve"],
      "port": 3100
    },
    {
      "name": "asma-indexable",
      "runtimeExecutable": "node",
      "runtimeArgs": ["scripts/e2e.mjs", "--indexable"],
      "port": 3100
    }
  ]
}
