{
  "name": "asma",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build && node scripts/check-sourcemaps.mjs",
    "start": "next start",
    "lint": "eslint .",
    "lint:rtl": "node scripts/check-logical-classes.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "node scripts/e2e.mjs",
    "guardrails": "node .claude/evals/guard.test.mjs",
    "db:test": "supabase test db",
    "db:types": "supabase gen types typescript --local > lib/db/database.types.ts",
    "launch:gate": "node scripts/launch-gate.mjs",
    "verify": "npm run guardrails && npm run typecheck && npm run lint && npm run lint:rtl && npm run format:check && npm run test",
    "prepare": "husky"
  },
  "dependencies": {
    "@sentry/nextjs": "10.75.2",
    "@supabase/ssr": "0.12.4",
    "@supabase/supabase-js": "2.112.3",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "input-otp": "1.5.0",
    "lucide-react": "1.59.0",
    "next": "16.4.6",
    "next-intl": "4.13.7",
    "posthog-js": "1.418.11",
    "radix-ui": "1.8.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "0.0.1",
    "tailwind-merge": "3.7.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "1.63.0",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "26.2.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.6",
    "fast-check": "4.10.2",
    "husky": "9.1.7",
    "lint-staged": "17.6.0",
    "prettier": "3.9.9",
    "supabase": "2.114.0",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "typescript-eslint": "8.67.0",
    "vitest": "5.0.5"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx,mjs,cjs}": [
      "prettier --write",
      "eslint --max-warnings=0 --no-warn-ignored"
    ],
    "*.{json,css}": "prettier --write"
  },
  "overrides": {
    "playwright-core": "1.63.0"
  },
  "allowScripts": {
    "@parcel/watcher@2.6.0": true,
    "@swc/core@1.15.47": true,
    "unrs-resolver@1.12.2": true,
    "@sentry/cli@2.58.6": true,
    "core-js@3.51.0": true
  }
}
