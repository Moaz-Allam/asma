{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node .claude/hooks/session-context.mjs",
            "timeout": 10
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node .claude/hooks/guard.mjs",
            "timeout": 15,
            "statusMessage": "Checking never-negotiable rules"
          }
        ]
      }
    ]
  },
  "permissions": {
    "allow": [
      "Read",
      "Grep",
      "Glob",
      "Bash(npx supabase test db*)",
      "Bash(npx supabase gen types*)",
      "Bash(npm run typecheck*)",
      "Bash(npm run lint*)",
      "Bash(npm run test*)",
      "Bash(npx tsc --noEmit*)",
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git log*)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.local)",
      "Read(./.env.production)",
      "Read(./**/*.pem)",
      "Read(./**/*.key)"
    ],
    "ask": [
      "Edit(.claude/hooks/**)",
      "Edit(.claude/settings.json)",
      "Edit(supabase/migrations/**)",
      "Edit(lib/money/**)",
      "Edit(lib/psp/**)",
      "Edit(lib/pricing/**)",
      "Bash(npx supabase db reset*)",
      "Bash(npx supabase db push*)"
    ]
  }
}
